# Docker 로컬 실행용 설정입니다. 이 파일을 .env.docker로 복사해 사용하세요.
# 실제 운영 비밀키는 저장소에 커밋하지 마세요.

JWT_SECRET_STRING=layover-docker-local-jwt-secret-change-before-production-1234567890
CHAT_CRYPTO_KEY=layover-docker-local-chat-crypto-key-change-me

# 외부 API가 없어도 백엔드는 실행됩니다. 필요한 기능의 키만 채우세요.
KAKAO_REST_API_KEY=
KAKAO_API_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=http://localhost:8080/api/login/kakao/callback
DAEJEON_BUS_API_KEY=
TOUR_API_KEY=
WEATHER_API_KEY=
TAGO_TRAIN_API_KEY=
AI_COURSE_API_KEY=

# 키가 없는 로컬 Docker 환경에서는 외부 호출 기능을 비활성화합니다.
WEATHER_ENABLED=false
AI_COURSE_ENABLED=false
TRAIN_API_PROVIDER=korail-sample
PLACE_SYNC_PUBLIC_ENABLED=false

# 기본은 로컬 Docker 볼륨에 업로드합니다. S3 사용 시 아래 값을 변경하세요.
STORAGE_TYPE=local
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*

MAIL_USERNAME=
MAIL_PASSWORD=
