# Public/non-secret settings
SPRING_PROFILES_ACTIVE=prod
APP_FRONTEND_URL=https://YOUR_PROJECT.pages.dev
APP_CORS_ALLOWED_ORIGINS=https://YOUR_PROJECT.pages.dev
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_TIDB_HOST:4000/daejeon_layover?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=YOUR_TIDB_USERNAME
REDIS_HOST=YOUR_UPSTASH_HOST
REDIS_PORT=6379
REDIS_SSL_ENABLED=true
EMAIL_VERIFICATION_STORAGE=redis
STORAGE_TYPE=s3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=YOUR_BUCKET
AWS_S3_PUBLIC_BASE_URL=https://YOUR_BUCKET.s3.ap-northeast-2.amazonaws.com
KAKAO_REDIRECT_URI=https://YOUR_CLOUD_RUN_URL/api/login/kakao/callback
PLACE_SYNC_PUBLIC_ENABLED=false
PLACE_SYNC_ON_STARTUP=false
PLACE_SYNC_SCHEDULER_ENABLED=false

# Register these as secrets; never commit their values.
SPRING_DATASOURCE_PASSWORD=SET_IN_SECRET_MANAGER
JWT_SECRET_STRING=SET_IN_SECRET_MANAGER
CHAT_CRYPTO_KEY=SET_IN_SECRET_MANAGER
MAIL_USERNAME=SET_IN_SECRET_MANAGER
MAIL_PASSWORD=SET_IN_SECRET_MANAGER
REDIS_PASSWORD=SET_IN_SECRET_MANAGER
AWS_ACCESS_KEY_ID=SET_IN_SECRET_MANAGER
AWS_SECRET_ACCESS_KEY=SET_IN_SECRET_MANAGER
KAKAO_CLIENT_ID=SET_IN_SECRET_MANAGER
KAKAO_CLIENT_SECRET=SET_IN_SECRET_MANAGER
KAKAO_REST_API_KEY=SET_IN_SECRET_MANAGER
KAKAO_API_KEY=SET_IN_SECRET_MANAGER
TMAP_API_KEY=SET_IN_SECRET_MANAGER
DAEJEON_BUS_API_KEY=SET_IN_SECRET_MANAGER
TOUR_API_KEY=SET_IN_SECRET_MANAGER
WEATHER_API_KEY=SET_IN_SECRET_MANAGER
TAGO_TRAIN_API_KEY=SET_IN_SECRET_MANAGER
AI_COURSE_API_KEY=SET_IN_SECRET_MANAGER
